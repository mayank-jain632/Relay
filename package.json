{
  "name": "contexthud",
  "displayName": "Relay",
  "version": "0.0.1",
  "private": true,
  "description": "Relay: Slack-to-IDE task execution",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:contexthud.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contexthud",
          "title": "Relay",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "contexthud": [
        {
          "id": "contexthud.sidebar",
          "name": "My Tasks",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "relay.refresh",
        "title": "Relay: Refresh"
      },
      {
        "command": "relay.initializeProjectConfig",
        "title": "Relay: Initialize Project Config"
      },
      {
        "command": "relay.linkWorkspace",
        "title": "Relay: Link Workspace"
      },
      {
        "command": "relay.diagnostics",
        "title": "Relay: Run Diagnostics"
      }
    ],
    "configuration": {
      "title": "Relay",
      "properties": {
        "relay.currentUser": {
          "type": "string",
          "default": "",
          "description": "Local/GitHub username used for private task filtering."
        },
        "relay.userMappingPath": {
          "type": "string",
          "default": ".relay/users.json",
          "description": "Workspace-relative JSON mapping of Slack user IDs to local usernames."
        },
        "relay.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8787",
          "description": "Backend API base URL."
        },
        "relay.user.handle": {
          "type": "string",
          "default": "",
          "description": "Assignee handle used for task filtering in the IDE (assignee=handle)."
        },
        "relay.git.branchPrefix": {
          "type": "string",
          "default": "ch",
          "description": "Branch prefix used when starting tasks."
        },
        "relay.git.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "Base branch used for GitHub compare URL generation."
        },
        "relay.git.commitPollIntervalSec": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "Polling interval in seconds for detecting new commits on active task branch."
        },
        "contexthud.currentUser": {
          "type": "string",
          "default": "",
          "description": "[Legacy] Use relay.currentUser instead."
        },
        "contexthud.userMappingPath": {
          "type": "string",
          "default": ".contexthud/users.json",
          "description": "[Legacy] Use relay.userMappingPath instead."
        },
        "contexthud.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8787",
          "description": "[Legacy] Use relay.apiBaseUrl instead."
        },
        "contexthud.user.handle": {
          "type": "string",
          "default": "",
          "description": "[Legacy] Use relay.user.handle instead."
        },
        "contexthud.git.branchPrefix": {
          "type": "string",
          "default": "ch",
          "description": "[Legacy] Use relay.git.branchPrefix instead."
        },
        "contexthud.git.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "[Legacy] Use relay.git.baseBranch instead."
        },
        "contexthud.git.commitPollIntervalSec": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "[Legacy] Use relay.git.commitPollIntervalSec instead."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run test:server && npm run build",
    "test:server": "node --test server/test/*.test.js",
    "db:migrate": "node server/scripts/migrate.js",
    "server:start": "node server/server.js",
    "start": "node server/server.js",
    "railway:start": "node server/server.js",
    "dashboard:install": "npm --prefix dashboard install",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:start": "npm --prefix dashboard run start"
  },
  "dependencies": {
    "express": "^4.21.2",
    "uuid": "^11.1.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.3",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
